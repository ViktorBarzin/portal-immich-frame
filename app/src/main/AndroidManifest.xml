<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Read the default gateway for the failure panel (FrameStatusView). A normal
      permission — granted at install, no runtime prompt on a device nobody is
      standing at. The friendlier label, the Wi-Fi SSID, is deliberately NOT read:
      since Android 8.1 that needs location permission, which is too much to hold
      on a kiosk for one line of diagnostic text.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Offer a downloaded build to the package installer (FrameUpdater). This does
      NOT allow silent installs — Android still shows its own confirmation dialog,
      which a person taps. It additionally needs the matching app-op allowed once
      per device, which is an adb one-liner and needs no Portal UI:
        adb shell appops set me.viktorbarzin.portalframe REQUEST_INSTALL_PACKAGES allow
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.dream" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!--
          The frame app you open manually. Exits via double-tap / long-press /
          Back (see FrameActivity). The idle experience is the screensaver
          (FrameDreamService) below — not a home-screen takeover.
        -->
        <activity
            android:name=".FrameActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives the package installer's status for a self-update and raises the
          confirmation prompt. Not exported: only our own PendingIntent targets it.
        -->
        <receiver
            android:name=".FrameInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="me.viktorbarzin.portalframe.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Screensaver / "Dream" - the primary idle display mechanism. -->
        <service
            android:name=".FrameDreamService"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>
    </application>
</manifest>

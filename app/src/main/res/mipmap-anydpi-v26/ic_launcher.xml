<?xml version="1.0" encoding="utf-8"?>
<!-- API 26+ launchers (Portal is API 29) use this adaptive icon. The opaque
     dark background fills the launcher's mask shape so the icon can never blend
     into the home-screen background and read as blank (the bug in v0.1.3–v0.1.5,
     where a transparent-cornered white-tile PNG with no adaptive icon vanished).
     Legacy mipmap-*/ic_launcher.png are the pre-26 opaque fallback. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
